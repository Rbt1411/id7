{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "mguHmi": [
      "ID7"
    ],
    "build": {
      "python": "kit/tools/build.py",
      "args": [
        "{id}"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "shared": [
        "kit/tools/build.py",
        "vendors/dpf_core/kit",
        "vendors/dpf_core/apps",
        "vendors/iconix_core/kit",
        "vendors/iconix_core/apps",
        "vendors/iconix_core/tools/iconix-audiod",
        "tools/iconix-audiod"
      ]
    }
  },
  "tools": [
    {
      "id": "iconix-audiod",
      "path": "tools/iconix-audiod",
      "title": "Iconix Audio",
      "description": "Experimenteller Audio-Dienst für Iconix Sounds",
      "optional": true,
      "uninstallable": true,
      "mguHmi": [
        "ID7"
      ]
    }
  ]
}
