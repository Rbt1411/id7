[Unit]
Description=SmartX short audio test service (experimental)
After=oapcontroller.service
RequiresMountsFor=/var/opt

[Service]
Type=simple
User=root
RuntimeDirectory=smartx-testd
RuntimeDirectoryMode=0755
ExecStart=/bin/sh /var/opt/smartx-testd/current/smartx-testd.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=oapcontroller.service
